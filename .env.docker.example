ENV=docker
POSTGRES_USER=zalbook
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=zalbook
POSTGRES_URL=postgresql+asyncpg://zalbook:replace-with-database-password@db:5432/zalbook
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-redis-password@redis:6379/1
CELERY_RESULT_URL=redis://:replace-with-redis-password@redis:6379/2
ACCESS_SECRET_KEY=replace-with-random-access-secret
REFRESH_SECRET_KEY=replace-with-different-random-refresh-secret
API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
